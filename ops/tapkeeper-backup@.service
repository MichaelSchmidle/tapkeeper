[Unit]
Description=Tapkeeper backup operation (%i)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/tapkeeper-backup --config /etc/tapkeeper-backup/config.json --scheduled %i
TimeoutStartSec=1h
TimeoutStopSec=90s
PrivateTmp=true
NoNewPrivileges=true
